# i20 AI Garage - Staging Environment Configuration
# Copy to .env for local staging testing, or set in Render Dashboard
#
# DO NOT COMMIT THIS FILE WITH REAL VALUES
# Use Render Dashboard Environment Variables for secrets

# =============================================================================
# APPLICATION MODE - STAGING DEFAULTS
# =============================================================================

# Force simulation mode - NO real OBD hardware connections
OBD_MODE=simulation

# Reduce CPU usage in containerized environment
SIMULATION_INTERVAL=1.0
TELEMETRY_REFRESH_INTERVAL=2.0

# Staging database (separate from production/local)
DATABASE_PATH=/app/data/i20_garage_staging.db

# =============================================================================
# AI / LM STUDIO CONFIGURATION
# =============================================================================
# LM Studio runs locally on developer machines.
# In cloud staging, this endpoint is NOT available.
#
# Options:
# 1. Leave unset/empty -> AI Assistant shows "LM Studio unavailable" message
# 2. Set to internal network endpoint if running LM Studio sidecar (advanced)
# 3. Set to a mock/test endpoint for deterministic UI testing

# LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1  # Only works with Docker Desktop
# LM_STUDIO_BASE_URL=                                      # Empty = disabled
LM_STUDIO_MODEL=qwen2.5-3b-instruct
LM_STUDIO_TEMPERATURE=0.7
LM_STUDIO_TIMEOUT=30

# =============================================================================
# OBD CONFIGURATION (SIMULATION MODE)
# =============================================================================
# These are ignored in simulation mode but kept for completeness
OBD_PORT=N/A
OBD_BAUDRATE=38400
OBD_PROTOCOL=auto

# =============================================================================
# STREAMLIT SERVER CONFIGURATION
# =============================================================================
# Render sets PORT environment variable automatically
# STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_CORS=false
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# =============================================================================
# PYTHON RUNTIME
# =============================================================================
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# OPTIONAL: AUTHENTICATION (if implementing)
# =============================================================================
# STREAMLIT_AUTH_TYPE=basic
# STREAMLIT_AUTH_USERNAME=staging
# STREAMLIT_AUTH_PASSWORD=changeme