# i20 AI Garage - Environment Configuration
# Copy this file to .env and modify values as needed

# LM Studio Configuration
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen2.5-3b-instruct
LM_STUDIO_TEMPERATURE=0.7
LM_STUDIO_TIMEOUT=30

# OBD Configuration
# Mode: "simulation" or "real"
OBD_MODE=simulation
# Serial port for real OBD adapter (Windows: COM3, Linux: /dev/ttyUSB0)
OBD_PORT=COM3
OBD_BAUDRATE=38400
OBD_PROTOCOL=auto

# Simulation Configuration
# Simulation update interval in seconds
SIMULATION_INTERVAL=0.5
# Telemetry refresh interval in seconds
TELEMETRY_REFRESH_INTERVAL=1.0

# Database
# Database path (relative to project root)
# DATABASE_PATH=data/i20_garage.db